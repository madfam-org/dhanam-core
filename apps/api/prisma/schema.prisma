// dhanam-core Prisma schema (AGPL-3.0-or-later).
//
// This is the OPEN-CORE data model: personal-finance budgeting, tracking of
// finances & assets, and wealth planning. Proprietary models (billing,
// subscriptions/pricing, payment-processor connect/marketplace, provider
// connections, KYC, ESG, usage metering, transaction execution/orders,
// compliance bridges, platform config, marketing) are intentionally absent.
//
// Setup: this schema has no bundled migrations. Create the schema with
//   pnpm --filter @dhanam-core/api db:push
// (prisma db push), or generate your own initial migration with
//   prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

