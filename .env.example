# =============================================================================
# dhanam-core — environment configuration (PLACEHOLDERS ONLY)
# =============================================================================
# Copy this file to `.env` and fill in real values locally. NEVER commit `.env`
# or any real secrets, database URLs, tokens, or credentials.
# =============================================================================

# ---- Core infrastructure ----------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL=postgresql://dhanam:dhanam@localhost:5432/dhanam
# Redis connection string (sessions, rate limiting).
REDIS_URL=redis://localhost:6379/0

# ---- API application --------------------------------------------------------
NODE_ENV=development
PORT=4000

# Local JWT auth. Generate strong random values (>= 32 chars).
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
# 32-byte key used for at-rest field encryption.
ENCRYPTION_KEY=replace-with-exactly-32-char-key-0000

# Application URLs.
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ---- FX rates (optional) ----------------------------------------------------
# Banco de México SIE token for MXN FX rates. Leave blank to disable.
BANXICO_API_TOKEN=

# ---- Object storage (optional) ----------------------------------------------
# S3-compatible storage (e.g. Cloudflare R2) for document uploads. Document
# upload is disabled when unset.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ---- Email (optional) -------------------------------------------------------
# dhanam-core ships a no-op mailer. Wire your own SMTP transport if you want
# real transactional email.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Dhanam <noreply@example.com>
SUPPORT_EMAIL=support@example.com

# ---- Document extraction (optional) -----------------------------------------
# OpenAI API key used by the manual-assets document-extraction service. Leave
# blank to disable statement/receipt extraction.
OPENAI_API_KEY=

# ---- Product analytics (optional) -------------------------------------------
# PostHog. Analytics are disabled when the key is unset.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ---- Error monitoring (optional) --------------------------------------------
SENTRY_DSN=

# ---- Web application (Next.js public env) -----------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
